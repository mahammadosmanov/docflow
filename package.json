{
  "name": "docflow-desktop",
  "version": "1.36.69",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "npm run audit:source && npm run build:frontend",
    "build:frontend": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "build:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/build_windows.ps1",
    "build:windows:cross": "bash tools/build_windows_cross.sh",
    "test": "node --test tools/*.test.mjs && vitest run --config frontend/vite.config.ts",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "version:check": "node tools/version_manager.mjs check",
    "version:next": "node tools/version_manager.mjs next",
    "versions": "node tools/version_manager.mjs list",
    "audit:docs": "node tools/docs_audit.mjs",
    "audit:source": "node tools/package_audit.mjs source",
    "audit:licenses": "node tools/license_audit.mjs",
    "gate": "npm run version:check && npm run audit:docs && npm run audit:source && npm test && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && npm run audit:licenses",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
